{
  "name": "soleye",
  "version": "1.0.0",
  "description": "Free Solana double-bottom Telegram alert bot",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "backtest": "tsx scripts/backtest.ts"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "better-sqlite3": "^12.11.1",
    "bs58": "^6.0.0",
    "dotenv": "^18.0.5",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "pino-pretty": "^13.1.3",
    "pm2": "^7.0.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
