# Required: token from @BotFather
TELEGRAM_BOT_TOKEN=

# Optional: Solana RPC. Defaults to the free public endpoint.
# A free Helius/other key works too, e.g. https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
RPC_URL=

# Optional: free key from https://portal.jup.ag (only needed once Jupiter retires the keyless lite-api host)
# JUPITER_API_KEY=

# On-chain live candles use the websocket of RPC_URL (public endpoint works; a free Helius URL is more robust).
# LIVE_TRACKING=0   # disable and use GeckoTerminal rotation only

# Optional overrides
# DB_PATH=./data/soleye.db
# LOG_LEVEL=info
# GT_RPM=5           # GeckoTerminal calls/min. Docs claim 10-30, but 5 is what held with zero 429s in testing.
# RUGCHECK_RPM=20
# RPC_RPM=120
# DRY_RUN=1          # log alerts instead of sending (no Telegram token needed)
